# 이 프로젝트 전용 값만 적는 파일입니다. git에는 올리지 마세요.
# API 키(KIWOOM_APP_KEY 등)는 중앙 파일(E:\dev\.env)에 두면 모든 프로젝트가 자동으로 읽습니다.
# 여기에도 같은 이름이 있으면 이 프로젝트에서는 여기 값이 우선합니다.

# 데이터/로그 저장 위치 (컴퓨터마다 다름)
DATA_DIR=./data
LOG_DIR=./logs

# home 또는 office. 비워두면 호스트명으로 자동판별 (config_loader.py의 host_map 등록 필요)
ENV_NAME=

# 키움증권 REST API -> 중앙 .env 로 이동 권장 (_setup\keys.bat migrate trading-system)
# KIWOOM_APP_KEY=
# KIWOOM_APP_SECRET=

# 대시보드 로그인 비밀번호 (이 프로젝트 전용)
DASHBOARD_PASSWORD=
# 실전/모의 전환은 여기서 하지 않고, config/base.yaml의 kiwoom.is_mock에서
# 직접 파일을 열어 바꾸도록 일부러 분리해뒀습니다 (실수로 실거래 전환 방지).

# 향후 로컬 LLM(gemma-2-9b) 연결 시 사용
LOCAL_LLM_MODEL_PATH=
