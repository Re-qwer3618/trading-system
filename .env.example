# 복사해서 .env 로 저장 후 값 채우기. git에는 올리지 마세요.

# 데이터/로그 저장 위치 (컴퓨터마다 다름)
DATA_DIR=./data
LOG_DIR=./logs

# home 또는 office. 비워두면 호스트명으로 자동판별 (config_loader.py의 host_map 등록 필요)
ENV_NAME=

# 키움증권 REST API (Open API 홈페이지에서 앱 등록 후 발급)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
# 실전/모의 전환은 여기서 하지 않고, config/base.yaml의 kiwoom.is_mock에서
# 직접 파일을 열어 바꾸도록 일부러 분리해뒀습니다 (실수로 실거래 전환 방지).

# 향후 로컬 LLM(gemma-2-9b) 연결 시 사용
LOCAL_LLM_MODEL_PATH=
